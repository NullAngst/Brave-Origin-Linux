#!/bin/sh
# Launcher for the Brave Origin AppImage.
HERE=$(dirname "$(readlink -f "$0")")
APP=$HERE/opt/brave-origin

# Same things Brave's own /opt/brave.com/brave-origin/brave-origin wrapper sets.
export CHROME_VERSION_EXTRA=stable
export LD_LIBRARY_PATH="$APP:$APP/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Point relaunches and "create shortcut" at the AppImage file itself, since
# the mount path changes every launch.
if [ -n "$APPIMAGE" ]; then
  export CHROME_WRAPPER="$APPIMAGE"
fi

exec "$APP/brave" "$@"
